root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{xml,yaml,yml,json,toml}]
indent_size = 2

[**/db/changelog/*.xml]
indent_size = 4

# the fixture is hashed byte for byte: no trailing newline
[**/contract/*.json]
insert_final_newline = false
